#!/usr/bin/env bash
# Mock mysqldump, driven by environment variables so failure paths are testable.
#
#   MOCK_MYSQLDUMP_FAIL=1        always fail with exit 2
#   MOCK_MYSQLDUMP_FAIL_TIMES=n  fail the first n invocations, then succeed
#   MOCK_MYSQLDUMP_EMPTY=1       succeed but write nothing
#   MOCK_MYSQLDUMP_NOFOOTER=1    succeed but omit the "Dump completed" footer

log="${MOCK_LOG:-/dev/null}"
printf 'mysqldump %s\n' "$*" >>"$log" 2>/dev/null || true

counter="${MOCK_COUNTER_DIR:-/tmp}/mysqldump"
count=0
[ -f "$counter" ] && count="$(cat "$counter")"
printf '%s\n' "$((count + 1))" >"$counter" 2>/dev/null || true

if [ "${MOCK_MYSQLDUMP_FAIL:-0}" = "1" ]; then
  printf 'mysqldump: Got error: 1045: Access denied for user\n' >&2
  exit 2
fi

if [ -n "${MOCK_MYSQLDUMP_FAIL_TIMES:-}" ] && [ "$count" -lt "${MOCK_MYSQLDUMP_FAIL_TIMES}" ]; then
  printf 'mysqldump: Got error: 2003: Can not connect to MySQL server\n' >&2
  exit 2
fi

if [ "${MOCK_MYSQLDUMP_EMPTY:-0}" = "1" ]; then
  exit 0
fi

printf -- '-- MySQL dump 10.13  Distrib 8.0.36\n'
printf -- '--\n'
printf 'CREATE TABLE t1 (id int);\n'
printf 'INSERT INTO t1 VALUES (1);\n'
if [ "${MOCK_MYSQLDUMP_NOFOOTER:-0}" != "1" ]; then
  printf -- '-- Dump completed on 2026-01-01  2:00:00\n'
fi
exit 0
