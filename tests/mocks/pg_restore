#!/usr/bin/env bash
# Mock pg_restore.
#
#   MOCK_PGRESTORE_FAIL=1 -> exit 1

log="${MOCK_LOG:-/dev/null}"
printf 'pg_restore %s\n' "$*" >>"$log" 2>/dev/null || true

if [ "${MOCK_PGRESTORE_FAIL:-0}" = "1" ]; then
  printf 'pg_restore: error: could not execute\n' >&2
  exit 1
fi

bytes=0
for a in "$@"; do
  [ -f "$a" ] && bytes=$(wc -c <"$a" | tr -d ' ')
done
printf 'pg_restore-bytes %s\n' "$bytes" >>"$log" 2>/dev/null || true
exit 0
